# Server port (AI Studio preview and local Node dev server run on port 3000)
PORT=3000

# ------------------------------------------------------------------
# Frontend Public Supabase Config (Safe for Vercel client env vars)
# When set, the PWA routes Web Push registration, preferences, test
# push, and diagnostics directly to Supabase Edge Functions.
# ------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------
# Backend / CLI Secrets (NEVER prefix with VITE_ or commit to GitHub)
# ------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# VAPID keys for Web Push (generate once with: npm run vapid:generate)
# For Supabase deployment, store these via: supabase secrets set ...
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@myadhan.lk

# Cron secret protecting dispatch-prayer-push / cleanup-subscriptions / /api/push/cron
CRON_SECRET=

# Local SQLite database file path when running server.ts locally
DATABASE_PATH=./data/my-adhan.db
