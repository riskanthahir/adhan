# Server port (AI Studio preview and production Node server run on port 3000)
PORT=3000

# VAPID keys for Web Push (generate once with: npm run vapid:generate)
# NEVER commit .env or expose VAPID_PRIVATE_KEY in client code, API responses, or GitHub.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@myadhan.lk

# SQLite database file path (defaults to ./data/my-adhan.db)
DATABASE_PATH=./data/my-adhan.db

# Optional secret to protect external POST /api/push/cron triggers
CRON_SECRET=
